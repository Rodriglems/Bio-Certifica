POSTGRES_DB=biocertifica
POSTGRES_USER=biocertifica
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Enquanto estiver sem dominio, pode manter assim.
# Quando dominio estiver pronto, ajuste para:
# CORS_ORIGINS=https://biocertifica.com.br,https://www.biocertifica.com.br,http://178.105.205.209
CORS_ORIGINS=http://178.105.205.209,http://localhost,http://127.0.0.1,capacitor://localhost

# Com nginx fazendo proxy /api no mesmo host, deixar vazio e recomendado:
VITE_API_BASE_URL=

# SMTP (opcional; necessario para recuperar senha por e-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bio Certifica <no-reply@biocertifica.com.br>
